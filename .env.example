# NODE_ENV: "development" (allows embedded PGlite / JSON seed fallback) or "production" (strictly requires PostgreSQL DATABASE_URL)
NODE_ENV="development"

# APP_URL: The URL where this applet is hosted (used for strict CORS & CSP)
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string (Single Source of Truth in production)
DATABASE_URL="postgresql://desa_user:desa_secure_2026@127.0.0.1:5432/desa_db"

# REDIS_URL: Optional Redis connection URL for multi-instance persistent rate limiting (falls back to PostgreSQL rate_limits table)
REDIS_URL=""

# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TELEGRAM_BOT_TOKEN: Optional token from @BotFather for real Telegram Bot API integration
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_WEBHOOK_SECRET: Optional secret token header to validate incoming Telegram Webhooks
TELEGRAM_WEBHOOK_SECRET=""

# DEFAULT_ADMIN_PASSWORD: Initial admin password on first seed
DEFAULT_ADMIN_PASSWORD="GantiPasswordKuat2026!"

# AUTO_BACKUP_HOURS: Optional auto-backup interval (0 = disabled)
AUTO_BACKUP_HOURS=24

# ALERT_WEBHOOK_URL: Optional webhook for health alerts
# ALERT_WEBHOOK_URL=

# NOTIFICATION_WEBHOOK_URL: Optional gateway for email/WhatsApp dispatch
# NOTIFICATION_WEBHOOK_URL=

# PAYMENT_PROVIDER: mock | midtrans | xendit
PAYMENT_PROVIDER=mock

# EMAIL_PROVIDER: none | sendgrid | resend | mailgun | webhook
EMAIL_PROVIDER=none
# SENDGRID_API_KEY=
# RESEND_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# EMAIL_FROM=noreply@example.com

# WHATSAPP_PROVIDER: none | twilio | meta | webhook
WHATSAPP_PROVIDER=none
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# META_WHATSAPP_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
